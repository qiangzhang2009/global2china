{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/en/", "destination": "/" },
    { "source": "/ja/", "destination": "/" },
    { "source": "/ko/", "destination": "/" },
    { "source": "/de/", "destination": "/" },
    { "source": "/fr/", "destination": "/" },
    { "source": "/es/", "destination": "/" },
    { "source": "/it/", "destination": "/" },
    { "source": "/pt/", "destination": "/" },
    { "source": "/ru/", "destination": "/" },
    { "source": "/ar/", "destination": "/" },
    { "source": "/zh/", "destination": "/" }
  ],
  "redirects": [
    { "source": "/(zh|en|ja|ko|de|fr|es|it|pt|ru|ar)", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
      ]
    }
  ]
}
